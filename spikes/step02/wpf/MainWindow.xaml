<Window x:Class="MS001.Step02.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MS001 Step02 — local WebView2 technical spike"
        Height="520" Width="840" MinHeight="350" MinWidth="500">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="14">
      <TextBlock Text="MS001 Step02 | Technical spike — not the released app" FontWeight="Bold" />
      <TextBlock x:Name="RuntimeStatus" Text="Checking WebView2 Runtime..." Margin="0,7,0,6"/>
      <Button x:Name="ProbeButton" Content="Probe tdjson DLL version (no login, no sends)"
              HorizontalAlignment="Left" Click="ProbeButton_Click"/>
      <TextBlock x:Name="TdlibStatus" Text="TDLib native probe not run" Margin="0,5,0,0"/>
    </StackPanel>
    <wv2:WebView2 x:Name="Browser" Grid.Row="1" Margin="14" />
  </Grid>
</Window>
